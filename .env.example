# ==========================================
# Cash Back Kart (CBK) Environment Config
# ==========================================

# Core Django Settings
SECRET_KEY=django-insecure-replace-this-in-production-cbk-secret-key-391823908
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:3000

# Database Configuration
# Options: sqlite (default for local dev) | mysql (staging/production)
DATABASE_ENGINE=sqlite

# MySQL Settings (Only required if DATABASE_ENGINE=mysql)
DB_NAME=cbk_db
DB_USER=cbk_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Financial & Rewards Business Rules
# Central rule: 10 CBK Coins = 1 INR (COINS_PER_INR is centrally fixed at 10)
# Minimum coins required for a withdrawal request
MIN_REDEMPTION_COINS=500

# Demo Seeding (Optional overrides for `python manage.py seed_demo`)
DEMO_ADMIN_EMAIL=admin@cashbackkart.in
DEMO_ADMIN_PASSWORD=Admin@123CBKSecure
